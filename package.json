{
  "name": "cardex",
  "private": true,
  "packageManager": "pnpm@11.20.0",
  "scripts": {
    "dev": "pnpm build:site && pnpm --dir packages/mcp-worker dev",
    "dev:site": "pnpm --dir packages/site dev",
    "build:site": "pnpm --dir packages/site build",
    "migrate": "pnpm --dir packages/mcp-worker migrate",
    "seed": "pnpm --dir packages/mcp-worker seed",
    "export-seed": "bash scripts/export-seed.sh",
    "demo": "pnpm build:site && pnpm migrate && pnpm seed && pnpm --dir packages/mcp-worker demo",
    "dup": "jscpd packages/mcp-worker/src && node scripts/dup-baseline.mjs",
    "lint": "eslint",
    "typecheck": "pnpm --dir packages/mcp-worker typecheck && pnpm --dir packages/site check",
    "test": "pnpm --dir packages/mcp-worker test"
  },
  "devDependencies": {
    "@typescript-eslint/parser": "8.72.1",
    "eslint": "10.13.0",
    "jscpd": "5.4.2"
  }
}
