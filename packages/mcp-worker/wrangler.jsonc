{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "cardex",
  "main": "src/index.ts",
  // Account IDs are not secrets; pinning it lets CI tokens that cannot list
  // accounts (no User -> Memberships read) still run d1 commands.
  "account_id": "05658a8d94b905714924bdafa0690068",
  // Set on the day this Worker was created (AGENTS.md); 2026-10-26 is the
  // newest date the pinned workerd binary supports.
  "compatibility_date": "2026-10-26",
  "compatibility_flags": ["nodejs_compat"],
  // Preview hostnames would bypass the Access app fronting /admin — off.
  "preview_urls": false,
  // The workers.dev hostname is likewise a route around Access — routes
  // already imply off, and this pins it so a routes edit cannot re-open it.
  "workers_dev": false,
  // Custom domain on the brandonhk.com zone; Access fronts /admin on it.
  "routes": [
    { "pattern": "cardex.brandonhk.com", "custom_domain": true }
  ],
  "observability": {
    "enabled": true,
    "traces": { "enabled": true }
  },
  // ADR 0015: the index-sync cadence. Worst case a freshly approved term is
  // discoverable within 15 min plus Vectorize's own propagation lag; an
  // unchanged run costs one list + one query and zero embedding calls.
  "triggers": {
    "crons": ["*/15 * * * *"]
  },
  // packages/site builds the public pages and the /admin island (ADR 0004).
  // Worker-first paths keep the MCP surfaces and the /admin identity check
  // ahead of static hosting; everything else is asset-first.
  "assets": {
    "directory": "../site/dist",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    "run_worker_first": ["/mcp", "/maintainer", "/admin*"]
  },
  // ADMIN_EMAIL is deliberately NOT a var — it is a secret
  // (`wrangler secret put ADMIN_EMAIL`) so the owner address never lands
  // in committed config. Cloudflare Access is the real boundary; this is
  // the second check inside the Worker.
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "cardex-db",
      "database_id": "d0616cb0-2def-4466-8568-8abd53ae41e8",
      "migrations_dir": "migrations"
    }
  ],
  // ADR 0014 (experimental): search_terms embeds the query with Workers AI
  // bge-m3, takes nearest neighbors from a Vectorize index of Term pointers,
  // then revalidates every hit against D1. The index is a derived candidate
  // store only — it never serves facts. The owner creates/populates
  // cardex-terms via scripts/term_search_index.py; an absent or empty index
  // degrades to search_unavailable / empty pages, never wrong facts.
  //
  // Local dev: AI bindings always call the remote (metered) API and Vectorize
  // has no local mode at all, so `wrangler dev` answers search_unavailable —
  // the fail-closed path. Setting "remote": true on both opts a local run
  // into the real resources; tests inject fakes and never touch these.
  "ai": { "binding": "AI" },
  "vectorize": [
    {
      "binding": "TERMS_INDEX",
      "index_name": "cardex-terms"
    }
  ]
}
