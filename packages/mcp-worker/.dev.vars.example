# Copy to .dev.vars for local `wrangler dev` (gitignored). Never commit real
# values. In production these are set with `wrangler secret put`.

# Bearer token for POST /maintainer. If unset, the route returns 404.
MAINTAINER_TOKEN=dev-maintainer-token

# Owner address allowed past the /admin identity check. In production set
# it with `wrangler secret put ADMIN_EMAIL` — never as a wrangler var.
ADMIN_EMAIL=owner@example.com

# Identity used for /admin when no Cf-Access-Authenticated-User-Email header
# is present (Access is not in the loop locally). Must match ADMIN_EMAIL.
DEV_ADMIN_EMAIL=owner@example.com

# Optional second factor on the approve action. Leave unset to disable.
# ADMIN_PIN=1234

# Optional: verify Cloudflare Access JWTs for /admin instead of trusting the
# identity header. ACCESS_TEAM is the Access team domain; ACCESS_AUD is the
# app's AUD tag (Access console → the /admin application). When both are
# set, a signed Cf-Access-Jwt-Assertion must verify — the header fallback
# (including DEV_ADMIN_EMAIL) is disabled.
# ACCESS_TEAM=your-team.cloudflareaccess.com
# ACCESS_AUD=64hexaudtag

# The header/DEV_ADMIN_EMAIL fallback already fires on localhost requests
# (wrangler dev). Escape hatch for non-localhost dev setups (e.g. LAN or a
# remote dev URL): set to "true" so the fallback applies off-loopback too.
# Never set in production — routable admin identity must come from a
# verified Access JWT.
# ALLOW_DEV_IDENTITY=true
